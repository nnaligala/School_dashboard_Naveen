# Copy to .env and change every CHANGE_ME value. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
SITE_DOMAIN=localhost:8080
SCHOOL_NAME=Naveen's School

DB_NAME=naveens_school
DB_USER=naveens_app
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=naveens
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=naveens_vhost

MEMCACHED_HOSTS=memcached:11211
CACHE_KEY_PREFIX=naveens

STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=5

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@naveens.school

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_AGE_SECONDS=3600
AUDIT_RETENTION_DAYS=730
GUNICORN_WORKERS=3
