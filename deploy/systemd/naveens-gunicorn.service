# Save as /etc/systemd/system/naveens-gunicorn.service
[Unit]
Description=Naveen's School Gunicorn
After=network-online.target
Wants=network-online.target

[Service]
User=naveens
Group=naveens
WorkingDirectory=/opt/naveens-school
EnvironmentFile=/etc/naveens-school.env
ExecStart=/opt/naveens-school/.venv/bin/gunicorn config.wsgi:application -c deploy/gunicorn/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
